---
import Layout from '../layouts/Layout.astro';

const cards = [
  {
    name: "Battle Penguin",
    type: "Water",
    power: 100,
    defense: 150,
    rarity: "Uncommon",
    image: "/battle_penguin.png",
  },
  {
    name: "Kitsune",
    type: "Magic",
    power: 300,
    defense: 400,
    rarity: "Uncommon",
    image: "/kitsune.png",
  },
  {
    name: "Flaming Phoenix",
    type: "Fire",
    power: 350,
    defense: 250,
    rarity: "Uncommon",
    image: "/flaming_phoenix.png",
  },
  {
    name: "Stone Golem",
    type: "Earth",
    power: 250,
    defense: 400,
    rarity: "Uncommon",
    image: "/stone_golem.png",
  },
  {
    name: "Thunder Wolf",
    type: "Lightning",
    power: 300,
    defense: 200,
    rarity: "Uncommon",
    image: "/thunder_wolf.png",
  },
  {
    name: "Kitsune X-Ultra",
    type: "Magic",
    power: 900,
    defense: 1200,
    rarity: "Uncommon",
    image: "/kitsune_x_ultra.png",
  },
  {
    name: "Venom Mantis X-Ultra",
    type: "Poison",
    power: 850,
    defense: 1350,
    rarity: "Ultra Rare",
    image: "/venom_mantis.png",
  },
  {
    name: "Armoured Dillo",
    type: "Nature",
    power: 550,
    defense: 700,
    rarity: "Rare",
    image: "/armoured_dillo.png",
  },
  {
    name: "Boxing Jellyfish",
    type: "Water",
    power: 400,
    defense: 250,
    rarity: "Uncommon",
    image: "/boxing_jellyfish.png",
  },
  {
    name: "Fireforged Skull Devil",
    type: "Demon",
    power: 750,
    defense: 500,
    rarity: "Rare",
    image: "/fireforged_skull_devil.png",
  },
  {
    name: "Giant Cloud",
    type: "Wind",
    power: 650,
    defense: 800,
    rarity: "Ultra Rare",
    image: "/giant_cloud.png",
  },
  { name: "Dragon Claw", type: "Item", image: "/dragon_claw.png" },
  { name: "Metal Shield", type: "Item", image: "/metal_shield.png" },
  { name: "Fossil of Healing", type: "Item", image: "/fossil_of_healing.png" },
  {
    name: "Demonic Goblin",
    type: "Demon",
    power: 950,
    defense: 1100,
    rarity: "Ultra Rare",
    image: "/demonic_goblin.png",
  },
  {
    name: "The G.O.A.T.",
    type: "",
    power: 50,
    defense: 100,
    rarity: "Common",
    image: "/the_goat.png",
  },
];

const rarityColor: Record<string, string> = {
  Common:    '#888',
  Uncommon:  '#4a9eff',
  Rare:      '#c850c0',
  'Ultra Rare': '#ff6b35',
  Legendary: '#D4AF37',
};
---

<Layout title="Cards" description="Browse all Battle Beast cards - beasts, predators, elementals, and guardians.">
  <section class="section">
    <div class="container">
      <h1 class="section-title">The Cards</h1>
      <p class="section-subtitle">
        100+ creatures across four types. Each card has unique power, defense, and special abilities.
      </p>

      <div class="grid">
        {cards.map((card) => (
          <article class="card">
            <div class="card-art" style={`background-image:url('${card.image}')`}></div>
            <div class="card-body">
              <h2 class="card-name">{card.name}</h2>
              <p class="card-type">{card.type}</p>
              {card.rarity && (
                <p class="card-rarity" style={`color:${rarityColor[card.rarity]}`}>{card.rarity}</p>
              )}
              {card.power !== undefined && (
                <div class="stats">
                  <span title="Power">⚔ {card.power}</span>
                  <span title="Defense">🛡 {card.defense}</span>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: #111;
    border: 1px solid #1f1f1f;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.15s, border-color 0.15s;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .card-art {
    aspect-ratio: 3/4;
    background-color: #1a0a0a;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }

  .card-body {
    padding: 1rem;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .card-rarity {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .card-type {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .stats {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .stats span { display: flex; align-items: center; gap: 0.25rem; }
</style>
